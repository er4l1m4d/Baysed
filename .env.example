# Safe defaults: observation never simulates or submits orders.
BOT_RUN_MODE=observation
BAYSE_BASE_URL=https://relay.bayse.markets
BAYSE_PUBLIC_KEY=
BAYSE_SECRET_KEY=
TRADE_CURRENCY=USD
# WAT trading windows, comma-separated start-end ranges.
TRADING_WINDOWS=14:00-22:00
POSITION_SIZE_NGN=100
MAX_TRADES_PER_DAY=0
DAILY_LOSS_LIMIT_NGN=0
KILL_SWITCH=false
STATE_PATH=state.json
RUNS_DIR=runs
# A cautious starter liquidity floor: 3x the NGN 100 position supports entry and a protected exit.
MIN_ENTRY_LIQUIDITY_NGN=300
MOMENTUM_THRESHOLD_PCT=0.01
MOMENTUM_WINDOW_SECONDS=120
VOLUME_SPIKE_MULTIPLIER=0.5
VOLUME_LOOKBACK_BARS=20
MIN_ATR_PCT=0.03
MAX_ATR_PCT=1.50
MIN_TIME_TO_EXPIRY_SECONDS=240
MAX_TIME_TO_EXPIRY_SECONDS=480
NO_ENTRY_BEFORE_EXPIRY_SECONDS=90
MAX_SPREAD=0.06
MAX_RELATIVE_SPREAD=0.12
MIN_YES_ENTRY_PRICE=0.47
MAX_NO_ENTRY_PRICE=0.58
MIN_DISPLACEMENT=0.03
MIN_MODEL_ENTRY_GAP=0.08
MAX_MODEL_ENTRY_GAP=0.18
MAX_TP_GAP=0.12
MIN_SIGNAL_STRENGTH=0.35
REQUIRE_TRENDING_ENTRY=true
EARLY_EXIT_PROFIT_PCT=0.80
EARLY_EXIT_LOSS_PCT=0.55
EXECUTION_PRICE_TOLERANCE_ABS=0.01
MAX_EXECUTION_QUOTE_AGE_S=20
MODEL_SHADOW_ENABLED=true
MODEL_SHADOW_EDGE_THRESHOLD=0.08
STRATEGY=mean_reversion_inversion
BTC_MATCH_TERMS=btc,bitcoin
RESOLUTION_REQUIRED_TERMS=binance,btc
