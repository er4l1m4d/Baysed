# Bayse Bot Environment Configuration

# Database (Neon PostgreSQL)
# Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/bayse_bot?sslmode=require

# Bayse API
BAYSE_BASE_URL=https://relay.bayse.markets
BAYSE_PUBLIC_KEY=your_public_key
BAYSE_SECRET_KEY=your_secret_key

# Trading Configuration
SERIES_SLUG=crypto-btc-15min
TRADE_CURRENCY=USD
BOT_RUN_MODE=observation

# Optional: Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
